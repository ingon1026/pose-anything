Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Image1
        - /MarkerArray1
      Splitter Ratio: 0.5
    Tree Height: 300
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Image
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/debug_image
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MarkerArray
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 40; 46
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      # 남쪽 위에서 비스듬히 내려다보는 궤도 시점 — 카메라 영상과 좌우가
      # 일치하면서(가방→책 = 왼→오른쪽) 좌클릭 회전·육면체 입체감 유지
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.05
      Yaw: 4.712
      Value: Orbit (rviz)
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Angle: 0
        Name: 수직 탑뷰 (영상과 동일)
        Scale: 450
        X: 0
        Y: 0
        Value: TopDownOrtho (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Image:
    collapsed: false
  Width: 1500
