Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Image1
        - /MarkerArray1
      Splitter Ratio: 0.5
    Tree Height: 300
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Image
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/debug_image
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: MarkerArray
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/markers
      Value: true
    # 객체별 점군. **기본 꺼짐이고, MarkerArray 와 같이 보라고 넣은 게 아니다** —
    # 상자와 점을 겹쳐 놓으면 둘 다 안 읽힌다. 기본 화면은 예전 그대로 MarkerArray 고,
    # 점군을 보고 싶으면 이 체크박스를 켜고 MarkerArray 를 끄는 식으로 갈아탄다.
    # 여기 항목이 없으면 토픽을 켜도 RViz 에서 손으로 추가해야 보이므로 항목만 둔다.
    # Color Transformer 는 RGB8 이어야 track_id 색이 나온다(기본값은 Intensity).
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: PointCloud2
      Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.002
      Style: Points
      Use Fixed Frame: true
      Use rainbow: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /perception/points
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 40; 46
    # **world 여야 한다.** perception_node.py:195-199 가 이 파일의 Fixed Frame 을
    # "world" 로 못박고 있다. 그러려면 publish_world_tf:=true 가 필요하다.
    #
    # 광학 프레임(camera_color_optical_frame)을 쓰면 안 된다 — +Z 가 카메라
    # 정면이고 위에서 내려다보는 이 셋업에서 그것은 물리적으로 **아래**다.
    # RViz 는 +Z 를 화면 위로 그리므로 높이가 통째로 뒤집힌다: 블록 윗면
    # (z=0.945)이 아래로, 구멍 바닥(z=0.983)이 위로 간다. 2026-08-28 에
    # "파인 부분이 본체보다 높아 보인다" 는 보고의 정체가 이것이었다.
    # 점군 값 자체는 옳았다 — 25프레임에서 전 블록 최고 높이 55.0mm 동일.
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      # 남쪽 위에서 비스듬히 내려다보는 궤도 시점 — 카메라 영상과 좌우가
      # 일치하면서(가방→책 = 왼→오른쪽) 좌클릭 회전·육면체 입체감 유지
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 1.05
      Yaw: 4.712
      Value: Orbit (rviz)
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Angle: 0
        Name: 수직 탑뷰 (영상과 동일)
        Scale: 450
        X: 0
        Y: 0
        Value: TopDownOrtho (rviz)
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Image:
    collapsed: false
  Width: 1500
