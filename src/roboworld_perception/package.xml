<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>roboworld_perception</name>
  <version>1.3.0</version>
  <description>Text-prompted conveyor object detection with 3D OBB pose (SAM3 + Open3D)</description>
  <maintainer email="157796083+ingon1026@users.noreply.github.com">ingon</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>message_filters</depend>
  <!-- perception_node.py 가 StaticTransformBroadcaster 를 런타임 임포트한다.
       ros-base 가 geometry2 로 항상 끌어오기 때문에 지금껏 안 드러났을 뿐이고,
       선언은 틀려 있었다. -->
  <depend>tf2_ros</depend>

  <test_depend>python3-pytest</test_depend>
  <!-- test_config_consistency.py 가 rviz 설정을 YAML 로 읽는다. -->
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
